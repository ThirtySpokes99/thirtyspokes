# ThirtySpokes environment. Copy to `.env` and fill in — `.env` is gitignored, never commit it.
#   cp .env.example .env

# Required for any live run (miner / validator / eval harness) — your OpenRouter inference budget.
# OPTIONAL for a validator: grounding mode (the default) does NO inference and needs no key.
# REQUIRED for a miner: it runs the benchmark and pays for it.
OPENROUTER_API_KEY=

# Miner proof/artifact uploads. Use a token scoped to the miner's public repo. A controlled test
# miner may intentionally reuse OWNER_HF_TOKEN, but production miners should have separate tokens.
MINER_HF_TOKEN=

# Official validator publication. Use a fine-grained owner/org token with write access to
# STANDINGS_REPO; the repository is forced public because the website fetches it anonymously.
OWNER_HF_TOKEN=
STANDINGS_REPO=

# Compatibility / optional gated datasets (Idavidrein/gpqa on HuggingFace).
HF_TOKEN=

# Optional. Alpha economics come from chain; set this only to add real USD conversions.
TAO_USD=

# --- docker compose (validator) ---------------------------------------------------------------
# Read by docker-compose.yml. Running the daemons directly instead? Pass these as CLI flags
# (--netuid / --wallet / --network); see docs/VALIDATOR.md.
NETUID=99                     # ThirtySpokes on Bittensor mainnet
VALIDATOR_WALLET=
VALIDATOR_HOTKEY=default
NETWORK=finney                # mainnet

# Optional validator tuning (see docs/VALIDATOR.md — calibrate before enabling).
# COMMIT_WINDOW=
# GRACE_BLOCKS=
