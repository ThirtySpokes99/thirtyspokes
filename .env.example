# Copy to `.env` and fill in. Never commit `.env`. Every variable below is read by name in the
# code (`git grep environ`); nothing else is.

# --- the owner's validator and owner tools ------------------------------------------------------
# The worker calls of the two reference arms, King zero's arm and the retest sample run on this key
# (whitepaper §4). Miners' arms run on the keys they register (D18), never on this one.
OPENROUTER_API_KEY=
# Cloudflare R2: the submissions bucket, the public mailbox and the reveals. The validator and
# `orchestra-owner` take the endpoint and bucket as arguments; the account and the parent key come
# from here. R2_SESSION_TOKEN is optional (a temporary parent credential).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
# The published world the daemon scores with (`thirtyspokes.v3.world:from_env`): the pinned λ/C
# table, King zero by name, the benchmarks, tasks per benchmark and the draw seed.
V3_EXCHANGE=runs/m3a-exchange.json
V3_KING0=cascade
V3_BENCHMARKS=livecodebench,hle
V3_TASKS_PER_BENCHMARK=125
V3_SEED=v3
# Gated benchmark datasets (HLE) are fetched with this token; HF_TOKEN is read as a fallback.
OWNER_HF_TOKEN=

# --- a miner ---------------------------------------------------------------------------------------
# `orchestra-miner register-key` reads the key from --key-file, else from this variable.
# OPENROUTER_API_KEY=
