# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Secrets & credentials — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
id_ed25519*
.bittensor/
wallets/

# Data & run outputs (regenerable — see README / docs).
# Root-anchored (leading /) so tests/data/ CI fixtures still ship.
/data/
/logs/
*.npz

# OS
.DS_Store

# validator runtime state: contains hotkeys and scores, never belongs in git
koth_validator_state.json
*_validator_state.json
state.json

# M3a run outputs — episodes are results, not source
m3a-*/
m3a-*.log

# transient agent worktrees — never part of the tree
.claude/worktrees/

server.config